# Copy to .env and adjust as needed. compose.yaml falls back to these values.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_PORT=5432
API_PORT=8080

# API settings. Every value is optional; the defaults below are what the API
# uses when the variable is unset or empty.
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
STARTUP_TIMEOUT=5s
READINESS_TIMEOUT=2s

# Connection pool tuning. Leave DB_MAX_CONNS empty to keep the pgx default.
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m
